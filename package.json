{
  "name": "@uniweb/scholar",
  "version": "0.2.2",
  "description": "Academic content utilities for Uniweb - numbered equations with cross-references, bibliographic references, and inline citations",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./math": "./src/math/index.js",
    "./bibliography": "./src/bibliography/index.js",
    "./citations": "./src/citations/index.js",
    "./components": "./src/components/index.js"
  },
  "files": [
    "src"
  ],
  "sideEffects": false,
  "keywords": [
    "uniweb",
    "scholar",
    "academic",
    "equations",
    "mathml",
    "bibliography",
    "citations",
    "bibtex",
    "apa",
    "mla"
  ],
  "author": "Proximify",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uniweb/scholar.git"
  },
  "homepage": "https://github.com/uniweb/scholar#readme",
  "bugs": {
    "url": "https://github.com/uniweb/scholar/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@citestyle/bibtex": "^1.0.0",
    "@citestyle/core": "^1.0.0",
    "@citestyle/registry": "^1.0.0",
    "@citestyle/styles": "^1.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "jsdom": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vitest": "^4.1.7"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  }
}
